AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_API_KEY=dev-ai-service-secret-change-me

# Transcription & Diarization (Open-source self-hosted defaults)
TRANSCRIPTION_PROVIDER=whisperx
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8
SEGMENT_DURATION_SECONDS=900
SEGMENT_OVERLAP_SECONDS=2

# Required by pyannote/speaker-diarization-3.1 on Hugging Face
HF_TOKEN=

# Optional Redis Queue Mode
REDIS_URL=
TRANSCRIPTION_QUEUE_KEY=voxameet:transcription:jobs

# Working scratch directory for FFmpeg audio normalization
AI_WORK_DIR=./work

