PORT=4002
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meeting_intelligence
DB_USER=meeting_app
DB_PASSWORD=meeting_app_password
DB_CONNECTION_LIMIT=15

JWT_ACCESS_SECRET=dev_access_secret_change_in_production_64chars_minimum_recommended
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_64chars_minimum_recommended
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 32-byte hex key (64 hex characters) used for encrypting integration OAuth tokens
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VoxaMeet AI <no-reply@voxameet.local>"

# --- Phase 2: Storage, Redis Queue & AI Microservice ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=uploads
MAX_UPLOAD_MB=2048
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=meeting-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=

REDIS_URL=
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=dev-ai-service-secret-change-me
BACKEND_PUBLIC_URL=http://127.0.0.1:4002

