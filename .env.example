# ==============================================================================
# VoxaMeet AI - Root Environment Example
# Copy service-specific .env files into backend/.env and frontend/.env.local
# ==============================================================================

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meeting_intelligence
DB_USER=meeting_app
DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# --- Redis (Job Queues & Pub/Sub) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Backend Server ---
PORT=4002
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_oauth_tokens

# --- SMTP / Email (Optional in dev: logs links to backend console if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VoxaMeet AI <no-reply@voxameet.local>"

# --- S3-Compatible Object Storage (MinIO locally or AWS S3 / R2 in production) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=meeting-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- AI Microservice (FastAPI + WhisperX + pyannote + Ollama + ChromaDB) ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=replace_with_internal_service_secret
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_URL=http://127.0.0.1:8001
HF_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4002/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4002

